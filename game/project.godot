; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Final Bell"
config/description="Симулятор бокса"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=3
anti_aliasing/quality/msaa_3d=3
environment/subsurface_scattering/subsurface_scattering_quality=2
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.03, 1)
lights_and_shadows/positional_shadow/atlas_size=8192
