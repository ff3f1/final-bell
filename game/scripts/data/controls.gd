static func hud_text(mouse: bool) -> String:
	if mouse:
		return "ЛКМ — передняя рука   ПКМ — задняя   Shift — силовой\n" + """Клик на месте — прямой   + мышь вбок — хук   вверх — апперкот   вниз — в корпус
""" + \
		"Пробел — блок (Shift+Пробел — корпус)   Ctrl+WASD — уклоны корпусом\n" + \
		"Q / E — уклоны   C — нырок   G — клинч   V — камера   F1 — скрыть"
	return "J K — прямые   U I — хуки   N M — апперкоты   X — в корпус   Shift — силовой\n" + """Пробел — блок   Ctrl+WASD — уклоны корпусом   Q / E — уклоны   C — нырок
""" + \
	"G — клинч   V — камера   F1 — скрыть"
